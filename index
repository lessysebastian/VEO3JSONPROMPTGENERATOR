import React, { useState } from 'react';
import { 
  Settings, 
  User, 
  Map, 
  Video, 
  Palette, 
  Activity, 
  Copy, 
  Check, 
  Trash2, 
  ChevronRight,
  Code,
  Plus,
  MessageSquare,
  Languages,
  UserPlus,
  X,
  Edit3,
  Music,
  Monitor,
  Clock,
  RotateCcw,
  Lock,
  Unlock
} from 'lucide-react';

// --- KOMPONEN REUSABLE ---

const NavItem = ({ icon, label, active, onClick }) => (
  <button 
    onClick={onClick}
    className={`flex items-center gap-4 w-full px-5 py-4 rounded-2xl transition-all duration-300 group relative overflow-hidden ${
      active 
      ? 'bg-indigo-600 text-white shadow-2xl shadow-indigo-600/30' 
      : 'text-slate-500 hover:bg-slate-800 hover:text-slate-200'
    }`}
  >
    <span className={`${active ? 'text-white' : 'text-slate-600 group-hover:text-indigo-400'} transition-colors duration-300`}>
      {icon}
    </span>
    <span className={`text-xs font-black tracking-wide uppercase ${active ? 'opacity-100' : 'opacity-70 group-hover:opacity-100'}`}>{label}</span>
    {active && (
      <div className="absolute right-4">
        <ChevronRight size={12} className="opacity-50" />
      </div>
    )}
  </button>
);

const CustomSelect = ({ label, value, customValue, options, onChange, onCustomChange }) => {
  const isCustom = value === 'Custom';
  return (
    <div className="flex flex-col gap-2 w-full">
      <label className="text-[10px] font-bold text-slate-500 uppercase tracking-widest ml-1">{label}</label>
      <div className="relative">
        <select 
          value={value} 
          onChange={(e) => onChange(e.target.value)} 
          className={`input-style appearance-none ${isCustom ? 'border-indigo-500/50' : ''}`}
        >
          {options.map(opt => <option key={opt} value={opt}>{opt}</option>)}
        </select>
        <div className="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-slate-500">
          <Plus size={14} />
        </div>
      </div>
      {isCustom && (
        <div className="mt-1 animate-in fade-in slide-in-from-top-1 duration-200">
          <div className="relative">
            <Edit3 size={14} className="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-400" />
            <input 
              type="text" 
              placeholder={`Tulis ${label} manual...`} 
              className="input-style pl-10 border-indigo-500/40 bg-indigo-500/5 ring-1 ring-indigo-500/20"
              value={customValue || ''}
              onChange={(e) => onCustomChange(e.target.value)}
              autoFocus
            />
          </div>
        </div>
      )}
    </div>
  );
};

// --- APLIKASI UTAMA ---

const App = () => {
  // --- STATE UNTUK SISTEM AKSES ---
  const [isAuthorized, setIsAuthorized] = useState(false);
  const [accessCodeInput, setAccessCodeInput] = useState('');
  const [authError, setAuthError] = useState(false);
  const REQUIRED_CODE = "JSONVEO3BYLESSY";

  const createNewSubject = () => ({
    id: crypto.randomUUID(),
    type: 'Human',
    type_custom: '',
    description: '',
    action: 'Standing',
    action_custom: '',
    dialog: {
      enabled: false,
      text: '',
      language: 'English',
      language_custom: '',
      accent: 'Neutral',
      accent_custom: ''
    }
  });

  const initialState = {
    aspect_ratio: '16:9 (YouTube/Desktop)',
    aspect_ratio_custom: '',
    video_duration: '10s',
    video_duration_custom: '',
    subjects: [createNewSubject()],
    environment: {
      location: 'Indoor',
      location_custom: '',
      time: 'Golden Hour',
      time_custom: '',
      weather: 'Clear',
      weather_custom: '',
      atmosphere: ''
    },
    audio: {
      music_enabled: false,
      genre: 'Cinematic',
      genre_custom: '',
      mood: 'Epic',
      mood_custom: '',
      volume: 75
    },
    camera: {
      angle: 'Eye Level',
      angle_custom: '',
      movement: 'Static',
      movement_custom: '',
      lens: '35mm Wide Angle'
    },
    style: {
      aesthetic: 'Photorealistic',
      aesthetic_custom: '',
      color_grading: 'Natural',
      lighting: 'Soft Studio Lighting',
      lighting_custom: ''
    },
    motion: {
      dynamic_range: 'Medium',
      flow: 'Continuous'
    }
  };

  const [promptData, setPromptData] = useState(initialState);
  const [activeTab, setActiveTab] = useState('general');
  const [copied, setCopied] = useState(false);

  const options = {
    subject: {
      types: ['Human', 'Animal', 'Object', 'Abstract', 'Vehicle', 'Custom'],
      actions: ['Standing', 'Walking', 'Running', 'Talking', 'Dancing', 'Gesturing', 'Custom'],
      languages: ['Indonesian', 'English', 'Japanese', 'Korean', 'French', 'German', 'Spanish', 'Custom'],
      accents: ['Neutral', 'British', 'American', 'Jakarta/Slang', 'Formal', 'Whispering', 'Custom']
    },
    general: {
      aspect_ratios: [
        '16:9 (YouTube/Desktop)', 
        '9:16 (TikTok/Reels/Shorts)', 
        '1:1 (Instagram Square)', 
        '4:5 (Social Feed)', 
        '21:9 (Cinemascope)', 
        'Custom'
      ],
      durations: ['5s', '10s', '15s', '30s', '60s', 'Custom']
    },
    audio: {
      genres: ['Cinematic', 'Ambient', 'Electronic', 'Lo-fi', 'Acoustic', 'Orchestral', 'Custom'],
      moods: ['Happy', 'Suspenseful', 'Dark', 'Calm', 'Epic', 'Melancholic', 'Custom']
    },
    environment: {
      locations: ['Forest', 'Cyberpunk City', 'Desert', 'Ocean', 'Studio', 'Modern Office', 'Space Station', 'Custom'],
      times: ['Daylight', 'Golden Hour', 'Blue Hour', 'Midnight', 'Sunrise', 'Custom'],
      weather: ['Clear', 'Rainy', 'Foggy', 'Snowy', 'Stormy', 'Heatwave', 'Custom']
    },
    camera: {
      angles: ['Eye Level', 'Low Angle', 'High Angle', 'Drone View', 'Close-up', 'Custom'],
      movements: ['Static', 'Pan Left/Right', 'Tilt Up/Down', 'Dolly Zoom', 'Tracking', 'Custom']
    },
    style: {
      aesthetics: ['Photorealistic', 'Anime Style', 'Oil Painting', '3D Render', 'Noir', 'Custom'],
      lighting: ['Soft Studio', 'Hard Sunlight', 'Neon/RGB', 'Volumetric', 'Candlelight', 'Custom']
    }
  };

  // --- HANDLER AUTENTIKASI ---
  const handleAuth = (e) => {
    e.preventDefault();
    if (accessCodeInput === REQUIRED_CODE) {
      setIsAuthorized(true);
      setAuthError(false);
    } else {
      setAuthError(true);
    }
  };

  const updateField = (category, field, value) => {
    if (category === null) {
      setPromptData(prev => ({ ...prev, [field]: value }));
    } else {
      setPromptData(prev => ({
        ...prev,
        [category]: { ...prev[category], [field]: value }
      }));
    }
  };

  const updateSubject = (id, field, value) => {
    setPromptData(prev => ({
      ...prev,
      subjects: prev.subjects.map(s => s.id === id ? { ...s, [field]: value } : s)
    }));
  };

  const updateSubjectDialog = (id, field, value) => {
    setPromptData(prev => ({
      ...prev,
      subjects: prev.subjects.map(s => s.id === id ? { ...s, dialog: { ...s.dialog, [field]: value } } : s)
    }));
  };

  const resetAllFields = () => {
    if (confirm("Apakah Anda yakin ingin menghapus semua data?")) {
      setPromptData(initialState);
      setActiveTab('general');
    }
  };

  const cleanValue = (val) => {
    if (typeof val !== 'string') return val;
    return val.split(' (')[0].trim();
  };

  const getCleanJson = () => {
    return JSON.stringify(promptData, (key, value) => {
      if (key === 'id') return undefined;
      if (key === 'aspect_ratio') return cleanValue(value);
      if (key === 'video_duration') return cleanValue(value);
      if (key === 'genre' || key === 'mood') return cleanValue(value);
      if (key === 'language' || key === 'accent') return cleanValue(value);
      return value;
    }, 2);
  };

  const copyToClipboard = () => {
    const jsonString = getCleanJson();
    const textArea = document.createElement("textarea");
    textArea.value = jsonString;
    document.body.appendChild(textArea);
    textArea.select();
    document.execCommand('copy');
    document.body.removeChild(textArea);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  // --- RENDER LAYAR LOGIN JIKA BELUM TEROTORISASI ---
  if (!isAuthorized) {
    return (
      <div className="min-h-screen bg-slate-950 flex items-center justify-center p-4 selection:bg-indigo-500/30">
        <div className="max-w-md w-full animate-in fade-in zoom-in duration-500">
          <div className="bg-slate-900/50 border border-slate-800 p-8 rounded-[2.5rem] shadow-2xl backdrop-blur-xl text-center">
            <div className="bg-gradient-to-br from-indigo-500 to-purple-600 w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-xl shadow-indigo-600/20">
              <Lock className="text-white" size={32} />
            </div>
            <h1 className="text-xl font-black tracking-tighter text-white mb-2 uppercase">VEO3 JSON PROMPT GENERATOR</h1>
            <p className="text-xs text-indigo-400 font-bold uppercase tracking-widest mb-8">by Lessy Sebastian</p>
            
            <form onSubmit={handleAuth} className="space-y-4">
              <div className="relative">
                <input 
                  type="password" 
                  placeholder="Masukkan Kode Akses..." 
                  className={`input-style text-center tracking-widest font-bold ${authError ? 'border-red-500 ring-2 ring-red-500/20' : ''}`}
                  value={accessCodeInput}
                  onChange={(e) => {
                    setAccessCodeInput(e.target.value);
                    setAuthError(false);
                  }}
                  autoFocus
                />
              </div>
              {authError && (
                <p className="text-[10px] text-red-400 font-bold uppercase animate-bounce">Kode akses salah. Silakan coba lagi.</p>
              )}
              <button 
                type="submit"
                className="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-black py-4 rounded-2xl transition-all shadow-xl shadow-indigo-600/20 active:scale-95 flex items-center justify-center gap-2"
              >
                <Unlock size={18} /> BUKA APLIKASI
              </button>
            </form>
            
            <p className="mt-8 text-[10px] text-slate-500 font-medium uppercase tracking-widest">Protected Environment</p>
          </div>
        </div>
      </div>
    );
  }

  // --- RENDER APLIKASI UTAMA ---
  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col md:flex-row font-sans selection:bg-indigo-500/30">
      
      {/* Sidebar Navigation */}
      <nav className="w-full md:w-72 bg-slate-900 border-r border-slate-800 p-6 flex flex-col gap-2 shrink-0">
        <div className="flex items-center gap-3 mb-8 px-2">
          <div className="bg-gradient-to-br from-indigo-500 to-purple-600 p-2.5 rounded-xl shadow-lg shadow-indigo-600/20">
            <Video className="w-6 h-6 text-white" />
          </div>
          <div>
            <h1 className="text-sm font-black tracking-tighter leading-tight uppercase">VEO3 JSON PROMPT<br/>GENERATOR</h1>
            <p className="text-[9px] text-indigo-400 font-bold uppercase tracking-widest opacity-80 mt-1">by Lessy Sebastian</p>
          </div>
        </div>

        <NavItem icon={<Monitor size={18}/>} label="Video & Format" active={activeTab === 'general'} onClick={() => setActiveTab('general')} />
        <NavItem icon={<User size={18}/>} label="Subjek & Karakter" active={activeTab === 'subject'} onClick={() => setActiveTab('subject')} />
        <NavItem icon={<Music size={18}/>} label="Musik & Audio" active={activeTab === 'audio'} onClick={() => setActiveTab('audio')} />
        <NavItem icon={<Map size={18}/>} label="Lingkungan" active={activeTab === 'environment'} onClick={() => setActiveTab('environment')} />
        <NavItem icon={<Settings size={18}/>} label="Kamera" active={activeTab === 'camera'} onClick={() => setActiveTab('camera')} />
        <NavItem icon={<Palette size={18}/>} label="Gaya Visual" active={activeTab === 'style'} onClick={() => setActiveTab('style')} />
        <NavItem icon={<Activity size={18}/>} label="Gerakan" active={activeTab === 'motion'} onClick={() => setActiveTab('motion')} />

        <div className="mt-auto pt-6 border-t border-slate-800">
          <div className="p-3 bg-slate-950/50 rounded-xl border border-slate-800">
            <p className="text-[10px] text-slate-500 leading-tight">Berhasil Terotorisasi. Selamat bekerja, Lessy Sebastian.</p>
          </div>
        </div>
      </nav>

      {/* Main Container */}
      <main className="flex-1 p-4 md:p-8 overflow-y-auto bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-indigo-900/10 via-slate-950 to-slate-950">
        <div className="max-w-4xl mx-auto">
          
          <div className="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <h2 className="text-3xl font-black mb-1 capitalize tracking-tight flex items-center gap-3">
                {activeTab === 'general' ? 'Video Format' : activeTab.replace('_', ' ')}
              </h2>
              <p className="text-slate-400 text-sm italic">Otorisasi Aktif: Panel Konfigurasi VEO 3.</p>
            </div>
            {activeTab === 'subject' && (
              <button 
                onClick={() => setPromptData(prev => ({ ...prev, subjects: [...prev.subjects, createNewSubject()] }))}
                className="bg-indigo-600 hover:bg-indigo-500 text-white px-5 py-2.5 rounded-2xl text-sm font-black flex items-center gap-2 transition-all shadow-xl shadow-indigo-600/30 active:scale-95"
              >
                <UserPlus size={18} /> Tambah Karakter
              </button>
            )}
          </div>

          <div className="space-y-6">
            
            {activeTab === 'general' && (
              <div className="bg-slate-900/40 border border-slate-800 rounded-[2.5rem] p-8 shadow-2xl space-y-8 animate-in fade-in duration-500">
                <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <CustomSelect 
                    label="Aspek Rasio (Ukuran)" 
                    value={promptData.aspect_ratio} 
                    customValue={promptData.aspect_ratio_custom}
                    options={options.general.aspect_ratios} 
                    onChange={(v) => updateField(null, 'aspect_ratio', v)}
                    onCustomChange={(v) => updateField(null, 'aspect_ratio_custom', v)}
                  />
                  <CustomSelect 
                    label="Durasi Video" 
                    value={promptData.video_duration} 
                    customValue={promptData.video_duration_custom}
                    options={options.general.durations} 
                    onChange={(v) => updateField(null, 'video_duration', v)}
                    onCustomChange={(v) => updateField(null, 'video_duration_custom', v)}
                  />
                </div>
                <div className="p-5 bg-indigo-500/5 rounded-2xl border border-indigo-500/10 flex items-start gap-4">
                  <Clock className="text-indigo-400 shrink-0 mt-1" size={18} />
                  <p className="text-xs text-slate-400 leading-relaxed">
                    <strong>Pembersihan Metadata Aktif:</strong> Versi ini secara otomatis mengirimkan nilai <span className="text-indigo-400 font-bold">9:16</span> murni ke VEO 3 untuk hasil vertikal.
                  </p>
                </div>
              </div>
            )}

            {activeTab === 'subject' && promptData.subjects.map((sub, index) => (
              <div key={sub.id} className="bg-slate-900/40 backdrop-blur-md border border-slate-800/60 rounded-[2.5rem] p-8 shadow-2xl relative animate-in slide-in-from-bottom-4 duration-500 mb-6">
                {promptData.subjects.length > 1 && (
                  <button onClick={() => setPromptData(prev => ({ ...prev, subjects: prev.subjects.filter(s => s.id !== sub.id) }))} className="absolute top-6 right-6 bg-red-500/10 hover:bg-red-500 text-red-500 hover:text-white p-2.5 rounded-full transition-all border border-red-500/20">
                    <X size={18} />
                  </button>
                )}
                <div className="flex items-center gap-4 mb-8 border-b border-slate-800 pb-6">
                  <div className="w-10 h-10 rounded-2xl bg-indigo-600 flex items-center justify-center text-sm font-black text-white shadow-lg shadow-indigo-600/20">#{index + 1}</div>
                  <h3 className="font-black text-slate-100 uppercase tracking-tighter text-lg">Konfigurasi Karakter</h3>
                </div>
                <div className="space-y-8">
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <CustomSelect label="Tipe Subjek" value={sub.type} customValue={sub.type_custom} options={options.subject.types} onChange={(v) => updateSubject(sub.id, 'type', v)} onCustomChange={(v) => updateSubject(sub.id, 'type_custom', v)} />
                    <CustomSelect label="Aksi Utama" value={sub.action} customValue={sub.action_custom} options={options.subject.actions} onChange={(v) => updateSubject(sub.id, 'action', v)} onCustomChange={(v) => updateSubject(sub.id, 'action_custom', v)} />
                  </div>
                  <textarea className="input-style min-h-[100px] bg-slate-950/50" placeholder="Deskripsi detail fisik dan pakaian..." value={sub.description} onChange={(e) => updateSubject(sub.id, 'description', e.target.value)} />
                  <div className="bg-indigo-500/5 rounded-[2rem] p-6 border border-indigo-500/10 space-y-6">
                    <div className="flex items-center justify-between">
                      <div className="flex items-center gap-3"><MessageSquare size={18} className="text-indigo-400" /><span className="font-bold text-slate-200 text-sm uppercase">Dialog Karakter</span></div>
                      <label className="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" checked={sub.dialog.enabled} onChange={(e) => updateSubjectDialog(sub.id, 'enabled', e.target.checked)} className="sr-only peer" />
                        <div className="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-slate-300 after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                      </label>
                    </div>
                    {sub.dialog.enabled && (
                      <div className="space-y-6 animate-in fade-in slide-in-from-top-2 duration-300">
                        <textarea className="input-style bg-slate-950 border-indigo-500/20" placeholder="Masukkan naskah dialog..." value={sub.dialog.text} onChange={(e) => updateSubjectDialog(sub.id, 'text', e.target.value)} />
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                          <CustomSelect label="Bahasa" value={sub.dialog.language} customValue={sub.dialog.language_custom} options={options.subject.languages} onChange={(v) => updateSubjectDialog(sub.id, 'language', v)} onCustomChange={(v) => updateSubjectDialog(sub.id, 'language_custom', v)} />
                          <CustomSelect label="Aksen" value={sub.dialog.accent} customValue={sub.dialog.accent_custom} options={options.subject.accents} onChange={(v) => updateSubjectDialog(sub.id, 'accent', v)} onCustomChange={(v) => updateSubjectDialog(sub.id, 'accent_custom', v)} />
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))}

            {activeTab === 'audio' && (
              <div className="bg-slate-900/40 border border-slate-800 rounded-[2.5rem] p-8 shadow-2xl space-y-8 animate-in fade-in duration-500">
                <div className="flex items-center justify-between bg-indigo-500/5 p-6 rounded-3xl border border-indigo-500/10">
                  <div className="flex items-center gap-3">
                    <div className="p-3 bg-indigo-600 rounded-2xl text-white shadow-lg shadow-indigo-600/20"><Music size={22} /></div>
                    <div>
                      <h3 className="font-black text-slate-100 uppercase tracking-tighter">Musik Latar</h3>
                      <p className="text-xs text-slate-500">Tambahkan skor musik untuk atmosfer video.</p>
                    </div>
                  </div>
                  <label className="relative inline-flex items-center cursor-pointer">
                    <input type="checkbox" checked={promptData.audio.music_enabled} onChange={(e) => updateField('audio', 'music_enabled', e.target.checked)} className="sr-only peer" />
                    <div className="w-14 h-7 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-slate-300 after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                  </label>
                </div>
                {promptData.audio.music_enabled && (
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-8 animate-in slide-in-from-top-4 duration-300">
                    <CustomSelect label="Genre Musik" value={promptData.audio.genre} customValue={promptData.audio.genre_custom} options={options.audio.genres} onChange={(v) => updateField('audio', 'genre', v)} onCustomChange={(v) => updateField('audio', 'genre_custom', v)} />
                    <CustomSelect label="Mood Musik" value={promptData.audio.mood} customValue={promptData.audio.mood_custom} options={options.audio.moods} onChange={(v) => updateField('audio', 'mood', v)} onCustomChange={(v) => updateField('audio', 'mood_custom', v)} />
                    <div className="flex flex-col gap-3 md:col-span-2">
                      <div className="flex justify-between items-center px-1">
                        <label className="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Volume Musik</label>
                        <span className="text-xs font-mono text-indigo-400 font-bold">{promptData.audio.volume}%</span>
                      </div>
                      <input type="range" className="w-full h-2 bg-slate-800 rounded-full appearance-none cursor-pointer accent-indigo-500" value={promptData.audio.volume} onChange={(e) => updateField('audio', 'volume', e.target.value)} />
                    </div>
                  </div>
                )}
              </div>
            )}

            {activeTab === 'environment' && (
              <div className="bg-slate-900/40 border border-slate-800 rounded-[2.5rem] p-10 shadow-2xl grid grid-cols-1 md:grid-cols-2 gap-10">
                <CustomSelect label="Lokasi Utama" value={promptData.environment.location} customValue={promptData.environment.location_custom} options={options.environment.locations} onChange={(v) => updateField('environment', 'location', v)} onCustomChange={(v) => updateField('environment', 'location_custom', v)} />
                <CustomSelect label="Waktu" value={promptData.environment.time} customValue={promptData.environment.time_custom} options={options.environment.times} onChange={(v) => updateField('environment', 'time', v)} onCustomChange={(v) => updateField('environment', 'time_custom', v)} />
                <CustomSelect label="Cuaca" value={promptData.environment.weather} customValue={promptData.environment.weather_custom} options={options.environment.weather} onChange={(v) => updateField('environment', 'weather', v)} onCustomChange={(v) => updateField('environment', 'weather_custom', v)} />
                <div className="flex flex-col gap-2">
                  <label className="text-[10px] font-bold text-slate-500 uppercase tracking-widest ml-1">Atmosfer & Mood</label>
                  <input type="text" className="input-style" placeholder="Misterius, nostalgic..." value={promptData.environment.atmosphere} onChange={(e) => updateField('environment', 'atmosphere', e.target.value)} />
                </div>
              </div>
            )}

            {(activeTab === 'camera' || activeTab === 'style' || activeTab === 'motion') && (
              <div className="bg-slate-900/40 border border-slate-800 rounded-[2.5rem] p-10 shadow-2xl space-y-8">
                <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                  {activeTab === 'camera' && (
                    <>
                      <CustomSelect label="Sudut Kamera" value={promptData.camera.angle} customValue={promptData.camera.angle_custom} options={options.camera.angles} onChange={(v) => updateField('camera', 'angle', v)} onCustomChange={(v) => updateField('camera', 'angle_custom', v)} />
                      <CustomSelect label="Gerakan Kamera" value={promptData.camera.movement} customValue={promptData.camera.movement_custom} options={options.camera.movements} onChange={(v) => updateField('camera', 'movement', v)} onCustomChange={(v) => updateField('camera', 'movement_custom', v)} />
                    </>
                  )}
                  {activeTab === 'style' && (
                    <>
                      <CustomSelect label="Estetika Visual" value={promptData.style.aesthetic} customValue={promptData.style.aesthetic_custom} options={options.style.aesthetics} onChange={(v) => updateField('style', 'aesthetic', v)} onCustomChange={(v) => updateField('style', 'aesthetic_custom', v)} />
                      <CustomSelect label="Pencahayaan" value={promptData.style.lighting} customValue={promptData.style.lighting_custom} options={options.style.lighting} onChange={(v) => updateField('style', 'lighting', v)} onCustomChange={(v) => updateField('style', 'lighting_custom', v)} />
                    </>
                  )}
                  {activeTab === 'motion' && (
                    <>
                      <div className="flex flex-col gap-4">
                        <label className="text-[10px] font-bold text-slate-500 uppercase tracking-widest ml-1">Dinamika Gerakan</label>
                        <input type="range" min="1" max="10" className="w-full h-2 bg-slate-800 rounded-full appearance-none cursor-pointer accent-indigo-500" value={promptData.motion.dynamic_range === 'Low' ? 2 : promptData.motion.dynamic_range === 'Medium' ? 5 : 8} onChange={(e) => { const v = parseInt(e.target.value); updateField('motion', 'dynamic_range', v < 4 ? 'Low' : v < 7 ? 'Medium' : 'High'); }} />
                      </div>
                      <CustomSelect label="Aliran Video" value={promptData.motion.flow} options={['Continuous', 'Slow-mo', 'Time-lapse']} onChange={(v) => updateField('motion', 'flow', v)} onCustomChange={() => {}} />
                    </>
                  )}
                </div>
              </div>
            )}

          </div>
        </div>
      </main>

      {/* Preview Sidebar */}
      <aside className="w-full md:w-[450px] bg-slate-900 border-l border-slate-800 p-8 flex flex-col h-screen md:sticky md:top-0 shrink-0 shadow-[-20px_0_50px_rgba(0,0,0,0.5)]">
        <div className="flex flex-col gap-6 mb-8">
          <div className="flex items-center gap-3 text-indigo-400">
            <div className="p-2 bg-indigo-500/10 rounded-lg"><Code size={20} /></div>
            <span className="font-black text-xs tracking-[0.3em] uppercase">JSON Preview</span>
          </div>
          <div className="flex gap-2">
             <button onClick={copyToClipboard} className={`flex-1 flex items-center justify-center gap-2 py-3.5 rounded-2xl text-[11px] font-black uppercase tracking-widest transition-all duration-300 shadow-xl active:scale-95 ${copied ? 'bg-emerald-500 text-white shadow-emerald-500/20' : 'bg-indigo-600 hover:bg-indigo-500 text-white shadow-indigo-600/20'}`}>
              {copied ? <Check size={16} /> : <Copy size={16} />}
              {copied ? 'Copied' : 'Copy JSON'}
            </button>
            <button onClick={resetAllFields} className="px-5 bg-slate-800 hover:bg-red-500/20 text-slate-400 hover:text-red-400 border border-slate-700 hover:border-red-500/50 rounded-2xl transition-all duration-300 group" title="Reset All Fields">
              <RotateCcw size={18} className="group-hover:rotate-[-90deg] transition-transform duration-500" />
            </button>
          </div>
        </div>
        <div className="flex-1 bg-black/50 rounded-[2rem] p-6 overflow-hidden border border-slate-800/50 flex flex-col shadow-inner backdrop-blur-xl">
          <pre className="text-[10px] font-mono text-indigo-300/80 leading-relaxed overflow-y-auto flex-1 custom-scrollbar">
            {getCleanJson()}
          </pre>
        </div>
        <div className="mt-8 p-6 bg-slate-950/80 border border-slate-800/50 rounded-[2rem] flex gap-5 items-center">
          <div className="p-3 bg-indigo-500/10 rounded-2xl text-indigo-400 shrink-0"><Video size={20} /></div>
          <p className="text-[10px] text-slate-500 leading-relaxed font-medium">
            JSON Generator Pro - <strong className="text-indigo-400">VEO 3 Ready</strong>. <br/>Branding: Lessy Sebastian.
          </p>
        </div>
      </aside>

      <style dangerouslySetInnerHTML={{ __html: `
        .input-style {
          width: 100%;
          background: #020617;
          border: 1px solid #1e293b;
          border-radius: 1.15rem;
          padding: 0.85rem 1.15rem;
          color: #f1f5f9;
          font-size: 0.875rem;
          font-weight: 500;
          transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .input-style:focus {
          outline: none;
          border-color: #6366f1;
          box-shadow: 0 0 0 5px rgba(99, 102, 241, 0.1);
          background: #0f172a;
        }
        .custom-scrollbar::-webkit-scrollbar {
          width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
          background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
          background: #1e293b;
          border-radius: 10px;
        }
        select.input-style {
          cursor: pointer;
        }
      `}} />
    </div>
  );
};

export default App;
